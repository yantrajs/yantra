<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
	  <AssemblyName>YantraJS.Network</AssemblyName>
	  <PackageId>YantraJS.Network</PackageId>
	  <PackageTags>yantrajs.network,network</PackageTags>
	  <Description>Network Services (fetch api) for YantraJS</Description>
	  <PackageProjectUrl>http://yantrajs.com/</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/yantrajs/yantra</RepositoryUrl>
	  <Version>1.0.1</Version>
	  <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
	  <IncludeSymbols>true</IncludeSymbols>
	  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	  <EmbedAllSources>True</EmbedAllSources>
	  <LangVersion>latest</LangVersion>
	  <!-- <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
	  <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath> -->
  </PropertyGroup>


	<!-- <ItemGroup>
		<Compile Remove="$(CompilerGeneratedFilesOutputPath)/*/**/*.cs" />
	</ItemGroup> -->

	<!-- Run code generation right before the CoreCompile step -->
	<Target Name="RunRoslynParser" BeforeTargets="CoreCompile">
		<PropertyGroup>
			<!-- Define the relative or absolute path to your parser executable -->
			<ParserExePath>$(SolutionDir)YantraJS.JSClassGenerator\bin\Debug\net8.0\YantraJS.JSClassGenerator.exe</ParserExePath>
		</PropertyGroup>

		<Message Importance="high" Text="[Pre-Build] Executing Roslyn Parser Engine..." />

		<!-- Execute the console app. Pass project directory as an argument if needed -->
		<Exec Command="&quot;$(ParserExePath)&quot; &quot;$(ProjectDir).&quot; &quot;$(ProjectDir)Generated&quot;" 
			  ContinueOnError="WarnAndContinue"/>
	</Target>


	<ItemGroup>
		<ProjectReference Include="..\YantraJS.Core\YantraJS.Core.csproj" />
		<PackageReference Include="Nerdbank.GitVersioning" Version="3.9.50">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
